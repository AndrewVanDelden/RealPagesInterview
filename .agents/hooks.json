{
  "agent-config": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [ { "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File agent/hooks/agy-hook.ps1", "timeout": 30 } ]
      }
    ]
  }
}