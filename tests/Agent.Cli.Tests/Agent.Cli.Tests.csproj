<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Agent.dll's own coverage is gated separately by Agent.Tests; scope this
         project's coverage run to the code it actually owns (Agent.Cli), so
         Agent's unrelated surface (e.g. the OpenAI HTTP path) does not drag
         this project's threshold below 100%. -->
    <Include>[Agent.Cli]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.msbuild" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Agent.Cli\Agent.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One source file, two test assemblies. Driving the real SDK into a
         ClientResultException that carries a vendor error body needs the same scripted
         transport Agent.Tests already has, and the rendered-log tests here are the only
         place a log line's final text can be asserted (LogLineFormatter is internal to
         Agent.Cli). Linked rather than copied so the two cannot drift apart. -->
    <Compile Include="..\Agent.Tests\TestSupport\FakeHttpMessageHandler.cs" Link="TestSupport\FakeHttpMessageHandler.cs" />
  </ItemGroup>

</Project>
